{
  "name": "@uzeful/docs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "bun ./node_modules/@docusaurus/core/bin/docusaurus.mjs start",
    "build": "bun ./node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "serve": "bun ./node_modules/@docusaurus/core/bin/docusaurus.mjs serve",
    "clear": "bun ./node_modules/@docusaurus/core/bin/docusaurus.mjs clear",
    "dev": "wrangler dev",
    "deploy": "bun run build && wrangler deploy --env main"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@mdx-js/react": "^3.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "typescript": "7.0.2",
    "wrangler": "4.112.0"
  }
}
